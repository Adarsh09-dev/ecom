<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>

    <link rel="stylesheet" href="/checkout-style/checkout.css">
</head>

<body>

    <div class="container">

        <!-- LEFT SIDE -->
        <div class="left">

            <h2 class="title">Choose your address</h2>

            <% if(createdAddress.length> 0){ %>

                <% createdAddress.forEach((address,index)=>{ %>

                    <div class="card">

                        <label>

                            <input type="radio" name="address" value="<%= address._id %>" <%=index===0 ? "checked" : ""
                                %>
                            >

                            <p>
                                <%= address.address_line %>
                            </p>

                        </label>

                        <p>
                            <%= address.city %>
                        </p>

                        <p>
                            <%= address.state %>
                        </p>

                        <p>
                            <%= address.country %> -
                                <%= address.pincode %>
                        </p>

                        <p>
                            <%= address.mobile %>
                        </p>

                    </div>

                    <% }) %>

                        <% } else { %>

                            <div class="card">
                                <p>No Address Found</p>
                            </div>

                            <% } %>

                                <form action="/address/add-address" method="GET">
                                    <input type="hidden" name="from" value="checkout">
                                    <button type="submit" class="add-address">
                                        + Add Address
                                    </button>

                                </form>

        </div>

        <!-- RIGHT SIDE -->
        <div class="right">

            <div class="summary">

                <h2>Summary</h2>

                <h3>Bill Details</h3>

                <div class="row">
                    <span>Items Total</span>
                    <span>₹<%= totalPrice %></span>
                </div>

                <div class="row">
                    <span>Quantity</span>
                    <span>
                        <%= totalQuantity %>
                    </span>
                </div>

                <div class="row">
                    <span>Delivery Charge</span>

                    <span>
                        <% if(deliveryCharge==0){ %>
                            Free
                            <% }else{ %>
                                ₹<%= deliveryCharge %>
                                    <% } %>
                    </span>

                </div>

                <hr>

                <div class="row total">

                    <strong>Grand Total</strong>

                    <strong>₹<%= grandTotal %></strong>

                </div>

                <form action="/order/payment" method="POST" id="payment-form">

                    <input type="hidden" name="addressId" id="onlineAddressId">

                    <button type="submit" class="pay-btn">
                        Online Payment
                    </button>

                </form>

                <form action="/order/cash-on-delivery" method="POST">

                    <input type="hidden" name="subTotalAmt" value="<%= totalPrice %>">

                    <input type="hidden" name="totalAmt" value="<%= grandTotal %>">

                    <input type="hidden" name="addressId" id="addressId">

                    <button type="submit" class="cod-btn">
                        Cash On Delivery
                    </button>

                </form>

            </div>

        </div>

    </div>



    <script>

        const paymentForm =
            document.getElementById("payment-form");


        paymentForm.addEventListener("submit", async function (event) {

            event.preventDefault();


            try {

                // Convert form data to URL encoded data
                const formData = new URLSearchParams(
                    new FormData(paymentForm)
                );


                console.log(
                    "ADDRESS ID SENT =",
                    formData.get("addressId")
                );


                const response = await fetch(
                    "/order/payment",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded"
                        },

                        body: formData
                    }
                );


                console.log(
                    "RESPONSE STATUS =",
                    response.status
                );


                const result =
                    await response.json();


                console.log(
                    "PAYMENT RESULT =",
                    result
                );


                if (result.success && result.url) {

                    console.log(
                        "REDIRECTING TO STRIPE..."
                    );


                    window.location.href =
                        result.url;

                } else {

                    alert(
                        result.message ||
                        "Payment failed"
                    );

                }


            } catch (error) {

                console.error(
                    "PAYMENT ERROR =",
                    error
                );

                alert(
                    "Something went wrong while starting payment."
                );

            }

        });

    </script>


    <script>

        const addressRadios =
            document.querySelectorAll('input[name="address"]');

        const addressIdInput =
            document.getElementById("addressId");

        const onlineAddressIdInput =
            document.getElementById("onlineAddressId");


        addressRadios.forEach(function (radio) {

            radio.addEventListener("change", function () {

                addressIdInput.value = this.value;

                onlineAddressIdInput.value = this.value;

                console.log(
                    "SELECTED ADDRESS =",
                    this.value
                );

            });

        });


        const checkedAddress =
            document.querySelector(
                'input[name="address"]:checked'
            );


        if (checkedAddress) {

            addressIdInput.value =
                checkedAddress.value;

            onlineAddressIdInput.value =
                checkedAddress.value;

            console.log(
                "DEFAULT ADDRESS =",
                checkedAddress.value
            );

        }

    </script>